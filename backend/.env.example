# Node environment: development or production.
NODE_ENV=production
# Render provides PORT in production; local default is 5000.
PORT=5000
# MongoDB connection string for the portfolio database.
MONGO_URI=
# Random signing secret. Production requires at least 32 non-placeholder characters.
JWT_SECRET=
# JWT lifetime accepted by jsonwebtoken, for example 7d.
JWT_EXPIRES_IN=7d
# Comma-separated exact frontend origins; no wildcard origins are supported.
CLIENT_URL=https://yk-portfolio-two.vercel.app
# Cookie SameSite policy: lax (recommended behind the Vercel API rewrite), none (direct cross-site API), or strict.
COOKIE_SAMESITE=lax
# Trusted proxy hops between the visitor and Express. Verify this after deployment.
TRUST_PROXY_HOPS=1
# Admin account email used by the login and initial admin creation scripts.
ADMIN_EMAIL=
# Initial admin password used only by create-admin when creating the account.
ADMIN_PASSWORD=
# Frontend path used for the admin UI. This does not provide security.
ADMIN_PATH=/yakshit-portfolio_5518
# Cloudinary product environment name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key; server-side only.
CLOUDINARY_API_KEY=
# Cloudinary API secret; server-side only.
CLOUDINARY_API_SECRET=
# Resend API key; server-side only.
RESEND_API_KEY=
# Sender identity; onboarding@resend.dev can only send to the account owner inbox.
RESEND_FROM=onboarding@resend.dev
# Inbox that receives portfolio inquiries.
INQUIRY_TO_EMAIL=
# Enable visitor auto-replies only after a sender domain is verified.
AUTO_REPLY_ENABLED=false
